{
  "name": "react-native-phone-input-field",
  "version": "0.1.0",
  "description": "International phone number input for React Native: country picker, as-you-type formatting and real-time validation powered by libphonenumber-js. Pure TypeScript, works in Expo Go.",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/src/index.d.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./zod": {
      "source": "./src/zod.ts",
      "import": {
        "types": "./lib/typescript/module/src/zod.d.ts",
        "default": "./lib/module/zod.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/zod.d.ts",
        "default": "./lib/commonjs/zod.js"
      }
    },
    "./core": {
      "source": "./src/core/index.ts",
      "import": {
        "types": "./lib/typescript/module/src/core/index.d.ts",
        "default": "./lib/module/core/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/core/index.d.ts",
        "default": "./lib/commonjs/core/index.js"
      }
    },
    "./package.json": "./package.json",
    "./min": {
      "source": "./src/min.ts",
      "import": {
        "types": "./lib/typescript/module/src/min.d.ts",
        "default": "./lib/module/min.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/min.d.ts",
        "default": "./lib/commonjs/min.js"
      }
    }
  },
  "files": [
    "src",
    "lib",
    "zod",
    "min",
    "core",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "workspaces": [
    "example"
  ],
  "sideEffects": [
    "./lib/*/core/index.js",
    "./lib/*/core/setupMax.js",
    "./lib/*/core/setupMin.js",
    "./lib/*/index.js",
    "./lib/*/min.js",
    "./lib/*/zod.js",
    "./src/core/index.ts",
    "./src/core/setupMax.ts",
    "./src/core/setupMin.ts",
    "./src/index.ts",
    "./src/min.ts",
    "./src/zod.ts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\" --max-warnings=0",
    "format": "prettier --write .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "build": "bob build",
    "clean": "rm -rf lib",
    "prepare": "bob build",
    "changeset": "changeset",
    "release": "yarn build && changeset publish",
    "example": "yarn workspace react-native-phone-input-field-example",
    "generate:country-names": "node scripts/generate-country-names.cjs"
  },
  "keywords": [
    "react-native",
    "expo",
    "phone",
    "phone-number",
    "phone-input",
    "country-picker",
    "libphonenumber",
    "validation",
    "e164",
    "international"
  ],
  "author": "Loïc Kadjiwanou",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loickadjiwanou/react-native-phone-input-field.git"
  },
  "bugs": {
    "url": "https://github.com/loickadjiwanou/react-native-phone-input-field/issues"
  },
  "homepage": "https://github.com/loickadjiwanou/react-native-phone-input-field#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "libphonenumber-js": "^1.13.14"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72",
    "zod": ">=3.22"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
  "devDependencies": {
    "@babel/core": "^7.28",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@testing-library/react-native": "14",
    "@types/jest": "^30.0.0",
    "@types/node": "^22",
    "@types/react": "^19.1.1",
    "babel-jest": "30",
    "eslint": "10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "30",
    "prettier": "^3.9.9",
    "react": "19.3.0",
    "react-native": "0.87.1",
    "react-native-builder-bob": "0.43.1",
    "test-renderer": "^1.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.1",
    "zod": "4"
  }
}
